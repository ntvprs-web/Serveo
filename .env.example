# Copy to .env. Keep real credentials out of source control.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SERVEO_PORT=3000
# Set this to the deployed HTTPS origin to enable production canonicals and sitemap URLs.
SITE_URL=
# Public addresses displayed for event reports and privacy requests.
SERVEO_SUPPORT_EMAIL=
SERVEO_PRIVACY_EMAIL=
NODE_ENV=development
COOKIE_SECURE=false
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
# Set to true only for local OTP testing; production always requires Twilio.
DEV_OTP_ALLOW=false

# Required for real SMS OTP. Create a Twilio Verify Service and add these values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
