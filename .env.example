# Copy to .env. Keep real credentials out of source control.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SERVEO_PORT=3000
# Set this to the deployed HTTPS origin to enable production canonicals and sitemap URLs.
SITE_URL=
# Public addresses displayed for event reports and privacy requests.
SERVEO_SUPPORT_EMAIL=
SERVEO_PRIVACY_EMAIL=
NODE_ENV=development
COOKIE_SECURE=false
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
# Set to true only for local OTP testing; production always requires Twilio.
DEV_OTP_ALLOW=false

# Required for real SMS OTP. Create a Twilio Verify Service and add these values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional Resend API key for real Email OTP delivery
RESEND_API_KEY=
EMAIL_FROM=SERVEO <onboarding@resend.dev>

# Firebase Authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=backend/firebase-service-account.json
FIREBASE_PROJECT_ID=

# Supabase Auth Client Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public mode never creates demo records. Enable samples only in private development.
SERVEO_DATA_MODE=private
SERVEO_DEMO_DATA=true
SERVEO_PORT=3002
REPORT_HIDE_THRESHOLD=3
FOOD_SAFE_HOURS=4
FOOD_DONATION_RADIUS_KM=50
FOOD_CLAIM_WAVE_MINUTES=15
VITE_MAPBOX_TOKEN=
